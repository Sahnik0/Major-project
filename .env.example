# Host & API settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Storage paths (relative to repo root or absolute)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
PARQUET_DIR=./data/parquet
DATABASE_URL=sqlite:///./data/sqlite/advisor.db

# Ollama LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# TimesFM Foundation Model
TIMESFM_VERSION=3.0
TIMESFM_REPO=google/timesfm-3.0-pytorch
HF_TOKEN=your_huggingface_token_here
HF_HUB_OFFLINE=0

# Application Defaults
DEFAULT_COUNTRY=IN
DEFAULT_SERVICE_LEVEL=0.90
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_REVIEW_PERIOD_DAYS=7
DEFAULT_HORIZON=28
